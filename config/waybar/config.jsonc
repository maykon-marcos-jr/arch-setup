// -*- mode: jsonc -*-
{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "height": 40, // Waybar height (to be removed for auto height)
    "spacing": 4, // Gaps between modules (4px)
    "output": ["*"],
    "mode": "dock",
    "exclusive": true,
    "passthrough": false,
    "reload_style_on_change": true,
    // Choose the order of the modules
    "modules-left": ["group/left"],
    "modules-center": ["group/center"],
    "modules-right": ["group/right"],
    "group/left": {
      "orientation": "inherit",
      "modules": [
        "custom/apps",
        "hyprland/workspaces",
        "hyprland/window"
        ]
    },
    "group/center": {
      "orientation": "inherit",
      "modules": [
        "clock",
        "custom/notification"
    ]
    },
    "group/right": {
      "orientation": "inherit",
      "modules": [
        "mpris",
        "tray",
        "wireplumber#sink",
        "wireplumber#source",
        "power-profiles-daemon",
        "bluetooth",
        "network",
        "battery"
    ]
    },
    "custom/apps": {
        "format": "🔍",
        "tooltip-format": "Search Apps ...",
        "on-click": "wofi"
    },
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "format": "{id}",
        "format-icons": {
            "urgent": "",
            "active": "",
            "default": ""
        }
    },
    "hyprland/window": {
        "format": "{title}",
        "tooltip-format": "{title}",
        "rewrite": {
            "(.*) — Mozilla Firefox": "  $1",
            "(.*@.*~)": ">  [$1]",
            "(.*) - Brave": "  $1",
            "(.*) - Visual Studio Code": "Code: $1"
        },
        "separate-outputs": true
    },
    "clock": {
        "format": "  {:%d/%m     %H:%M}",
        "format-alt": "  {:%a, %d %b     %H:%M}",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "week-pos": "right",
            "on-scroll": "1",
            "format": {
                "months":     "<span color='#ffead3'><b>{}</b></span>",
                "days":       "<span color='#ecc6d9'><b>{}</b></span>",
                "weeks":      "<span color='#99ffdd'><b>{}</b></span>",
                "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
                "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_down",
            "on-scroll-down": "shift_up"
        },
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    "custom/notification": {
        "tooltip": true,
        "tooltip-format": "Left Click: Launch Notification Center\nRight Click: Do not Disturb",
        "format": "{} {icon} ",
        "format-icons": {
            "notification": "<span foreground='red'></span>",
            "none": "",
            "dnd-notification": "<span foreground='red'></span>",
            "dnd-none": "",
            "inhibited-notification": "<span foreground='red'></span>",
            "inhibited-none": "",
            "dnd-inhibited-notification": "<span foreground='red'></span>",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "sleep 0.1 && swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    // midia
    "mpris": {
        "format": "{player_icon} <i>{dynamic}</i>",
        "format-paused": "{status_icon} ",
        "on-click": "playerctl play-pause",
        "max-length": 30,
        "tooltip": true,
        "tooltip-format": "{player_icon}   Left click: Play/Pause    {status_icon}\n{dynamic}",
        "player-icons": {
            "chromium": "",
            "default": "",
            "firefox": "",
            "kdeconnect": "",
            "mopidy": "",
            "mpv": "󰐹",
            "spotify": "",
            "vlc": "󰕼"
        },
        "status-icons": {
            "paused": "▐▐",
            "playing": "▶",
            "stopped": "◼"
        }
    },
    "tray": {
        "icon-size": 20,
        "spacing": 15,
        "show-passive-items": true
    },
    "custom/gmail": {
        "exec": "gmail-tray --once | grep '{'",
        "interval": 30,
        "return-type": "json",
        "format": "✉ {}"
    },
    // output audio
    "wireplumber#sink": {
        "format": "{icon}   {volume}%",
        "format-muted": "",
        "format-icons": [
            "", "", "󰕾", ""
        ],
        "align": 0.5,
        "justify": "center",
        "scroll-step": 5,
        // toggles output on left click, opens wiremix on right click, can be set to "none" for no action
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "ghostty -e wiremix"
    },
    // input audio
    "wireplumber#source": {
        "node-type": "Audio/Source",
        "format": "  {volume}%",
        "format-muted": "",
        "align": 0.5,
        "justify": "center",
        "scroll-step": 5,
        // toggles source on left click, opens wiremix on right click, can be set to "none" for no action
        "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
        "on-click-right": "ghostty -e wiremix"
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },
    "bluetooth": {
        "format": " {status}",
        "format-on": "<big><b>ᛒ</b></big>",
        "format-off": "<big><b>ᚼ</b></big>",
        "format-connected": "",
        "interval": 30,
        "tooltip-format-connected": "{num_connections} Device(s) connected\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "- {device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_battery_percentage}% - {device_alias}",
        "format-no-controller": "",
        "on-click": "if (bluetoothctl show | grep 'Powered: yes') then { bluetoothctl power off; } else { bluetoothctl power on; } fi",        "on-click-right": "ghostty -e bluetui"
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format": "{essid:.20}",
        "format-alt": "{essid}",
        "format-wifi": "{icon}",
        "format-ethernet": "📶",
        "format-disconnected": "⚠",
        "tooltip-format": "{essid}\nIP: {ipaddr}\n{ifname} / {gwaddr}/{cidr}",
        "tooltip-format-wifi": "{essid}\nSignal: {signalStrength}%\nIP: {ipaddr}\n{ifname} / {gwaddr}/{cidr}",
        "on-click-right": "nm-connection-editor",
        "format-icons": [
            "󰤯", "󰤟", "󰤢", "󰤥", "󰤨"
        ]
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{icon}",
        "format-plugged": "{capacity}% ",
        "tooltip-format": "Battery: {capacity}%\nPower: {power} Watts\nHealth: {health}%",
        "events": {
            "on-discharging-warning": "notify-send -u normal 'Low Battery'",
            "on-discharging-critical": "notify-send -u critical 'Very Low Battery'"
        },
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    }
}
